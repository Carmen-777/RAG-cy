# --- data/ : ignore local data files, preserve folder structure ---
# Ignore all files under data/
data/**/*
# Allow Git to traverse directories
!data/**/
# Placeholder files (empty folder structure)
!data/**/.gitkeep
# Example company index (only tracked CSV)
!data/stock_data/subset.csv.example

# --- Data file types (global; subset.csv.example exempted above) ---
*.csv
!data/stock_data/subset.csv.example
*.xlsx
*.pdf
*.pkl
*.faiss
*.index

# Generated answers / debug under stock_data
data/stock_data/answers_*.json
data/stock_data/answers_*_debug.json
# Broker report folders, e.g. 【上海证券】*.md / 【*】*_merged/
/【*/
/*_merged/
# MinerU UUID output directories at repository root
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*/
/中芯国际*/

# --- Data files (also under other paths) ---
*.csv
*.xlsx

