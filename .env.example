# 复制本文件为 .env 并填入真实密钥（切勿提交 .env 到 Git）
# Copy this file to .env and fill in your keys. Never commit .env.

# ---------------------------------------------------------------------------
# 必需（Streamlit 问答 / 向量检索 / DashScope 重排序）
# ---------------------------------------------------------------------------
# 阿里云 DashScope（通义千问回答、Embedding、qwen3-vl-rerank 重排序）
# 获取：https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---------------------------------------------------------------------------
# 可选（按功能启用）
# ---------------------------------------------------------------------------

# Jina 重排序（侧边栏选择「Jina (高精度)」时需要）
# 获取：https://jina.ai/reranker/
JINA_API_KEY=your_jina_api_key_here

# OpenAI（仅在使用 OpenAI provider 或旧版 pipeline 配置时需要）
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini（仅在使用 Gemini provider 时需要）
GEMINI_API_KEY=your_gemini_api_key_here

# IBM Watson（竞赛遗留配置，一般不需要）
IBM_API_KEY=your_ibm_api_key_here

# MinerU PDF 解析（运行 pdf_mineru 离线解析流水线时需要）
MINERU_API_KEY=your_mineru_api_key_here
